# FreeCloud AI Studio Configuration

# Server
FREECLOUD_HOST=0.0.0.0
FREECLOUD_PORT=8000
FREECLOUD_ENV=development
FREECLOUD_LOG_LEVEL=INFO

# Storage
FREECLOUD_DATA_DIR=./data
FREECLOUD_UPLOAD_MAX_MB=250

# Worker Orchestration (GitHub Actions)
# Target allocation: 1m->4, 2m->5, 3m->6, 5m->7, 10m->8, 15m->10
GITHUB_ACTIONS_ENABLED=false
GITHUB_REPOSITORY=owner/FreeCloud-AI-Studio
GITHUB_WORKFLOW_ID=worker_runner.yml
GITHUB_PAT_TOKEN=ghp_example_token_placeholder
WORKER_HEARTBEAT_TIMEOUT_SEC=120
WORKER_TASK_LEASE_SEC=300
WORKER_MAX_RETRIES=2

# ComfyUI Integration
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_ENABLED=false
COMFYUI_TIMEOUT_SEC=180

# Continuity Engine Flags
CONTINUITY_IDENTITY_STRICT=true
CONTINUITY_MOTION_TRACKING=true
CONTINUITY_AUDIO_SYNC=true
CONTINUITY_MIN_QUALITY_SCORE=0.75
