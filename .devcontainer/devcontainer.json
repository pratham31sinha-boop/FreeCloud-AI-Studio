{
  "name": "FreeCloud AI Studio (16GB RAM Cloud PC)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "forwardPorts": [8000, 8188],
  "portsAttributes": {
    "8000": {
      "label": "FreeCloud AI Studio Web UI",
      "onAutoForward": "openBrowser"
    },
    "8188": {
      "label": "ComfyUI Server",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
